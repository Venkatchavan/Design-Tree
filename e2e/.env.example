# Copy to .env and fill in. Never commit .env.
# Local-dev e2e (isolated DB, seeded FD only).
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5000

# Isolated mongo for e2e (do NOT point at production designtree DB).
E2E_MONGO_URI=mongodb://127.0.0.1:27017/designtree-e2e

# Founding Director seed (must match api/.env SEED_* used with `npm run seed`).
E2E_FD_EMAIL=founding.director@designtree.com
# E2E_FD_PASSWORD is read from api/.env SEED_PASSWORD at runtime; set here only for CI.
# E2E_FD_PASSWORD=change-me

# Shared password for the 11 workflow logins (§0.5).
E2E_TEST_PASSWORD=Test@1234
