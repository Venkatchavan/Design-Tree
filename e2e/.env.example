# Copy to .env and fill in. Never commit .env.
# Local-dev e2e (isolated DB, seeded superuser only).
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5000

# Isolated mongo for e2e (do NOT point at production designtree DB).
E2E_MONGO_URI=mongodb://127.0.0.1:27017/designtree-e2e

# Superuser seed (must match the api/.env SEED_* used with `npm run seed`).
E2E_SU_EMAIL=superuser@designtree.com
# Required for specs/01: must equal the api SEED_PASSWORD. The specs read
# E2E_SU_PASSWORD directly (nothing auto-reads api/.env), so uncomment and
# set it here for local runs and CI alike. Left commented, specs/01 skips
# itself with a setup message instead of failing.
# E2E_SU_PASSWORD=change-me

# Shared password for the 11 cast logins created by specs/01-cast-creation.
E2E_TEST_PASSWORD=Test@1234
