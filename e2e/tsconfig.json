{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./node_modules/.cache/ts-check",
    "rootDir": "."
  },
  "include": ["playwright.config.ts", "fixtures/**/*.ts", "helpers/**/*.ts", "specs/**/*.ts"]
}
