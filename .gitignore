node_modules
dist
# Environment files (keep examples)
.env
.env.*
.envrc
!.env.example
!**/.env.example
uploads/
# Production deployment secrets / host-local files (never commit).
certs/
certs/*.crt
certs/*.key
*.srl
*.crl
*.csr
*.pem
*.key
*.p12
*.pfx
*.jks
gateway/.htpasswd
gateway/.httpasswd
gateway/pki/
# Exception: the rollout/ folder intentionally ships the PUBLIC CA cert
# (no secret) alongside its installer, so any PC can trust the LAN CA.
!rollout/*.crt
backups/
# Live MongoDB bind dir on the server (never commit database files).
mongo-data/
# OS junk
Thumbs.db
desktop.ini
.DS_Store
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Build/test output
coverage/
.nyc_output/
*.tsbuildinfo
