# DesignTree production deployment — COPY to `.env` and fill in (never commit `.env`).
# Full reference for every variable: docs/ENVIRONMENT.md.

# ---------- App ----------
NODE_ENV=production
PORT=5000
# Same-origin: browser and API share https://<server>, so the SPA needs no API URL.
VITE_API_URL=
# Public origin users type in the browser. Must match the TLS cert + nginx server_name.
CLIENT_ORIGIN=https://designtree.local
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Auth (GENERATE fresh values — never reuse dev/demo secrets) ----------
# 64+ random hex chars, e.g. from:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_64_HEX_CHARS
JWT_EXPIRES_IN=1d
COOKIE_NAME=token

# ---------- MongoDB ----------
MONGO_ROOT_USER=dtadmin
# URL-ENCODE if it contains @ : / ? # [ ] — safest is letters+digits+_.-
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Live database files (host bind, Windows style with forward slashes).
# Survives `down -v` / `volume prune`; folder must exist before first boot.
HOST_MONGO_DIR=C:/DesignTree/mongo-data
# NOTE: MONGO_URI is assembled in docker-compose.yml from the two vars above;
# it is NOT set here (single source of truth, no drift).

# ---------- File storage (host HDD paths, Windows style with forward slashes) ----------
# Uploads live here on the HOST filesystem: survive container loss AND `down -v`.
HOST_UPLOADS_DIR=D:/designtree-uploads
# mongodump archives land here (written by scripts/backup.ps1 via the container).
HOST_BACKUPS_DIR=E:/DesignTree/backup

# ---------- Seed superuser login (one-shot `npm run seed`, then rotate password in-app) ----------
SEED_NAME=Superuser
SEED_EMAIL=superuser@designtree.com
SEED_PASSWORD=REPLACE_WITH_ONE_TIME_PASSWORD

# ---------- DB admin (/dbadmin, Founding Director only) ----------
# nginx basic-auth user (hash goes in gateway/.htpasswd — see gateway/htpasswd.example).
DBADMIN_USER=founding-director
# mongo-express's own login screen (second gate after nginx basic-auth).
ME_CONFIG_BASICAUTH_USERNAME=founding-director
ME_CONFIG_BASICAUTH_PASSWORD=REPLACE_WITH_DBADMIN_PASSWORD
# FD office PC address for the nginx IP allowlist (gateway/nginx.conf EDIT-ME).
DBADMIN_ALLOW_IP=192.168.1.50
