# DesignTree production deployment — COPY to `.env` and fill in (never commit `.env`).
# Full reference for every variable: docs/ENVIRONMENT.md.

# ---------- App ----------
NODE_ENV=production
PORT=5000
# Same-origin: browser and API share the same host, so the SPA needs no API URL.
VITE_API_URL=
# Public origins users type in the browser (comma-separated allowlist when
# LAN + public IPs serve in parallel). IP-only — no domain.
CLIENT_ORIGIN=https://REPLACE_WITH_PUBLIC_IP,http://REPLACE_WITH_PUBLIC_IP,http://REPLACE_WITH_LAN_IP
HTTP_PORT=80
HTTPS_PORT=443
# Host port for the public HTTPS listener. The router forwards WAN:443 here,
# so users still type https://<public-ip> with no port. Host 443 stays LAN
# HTTPS on the internal CA certificate.
HTTPS_PUBLIC_PORT=4433

# ---------- TLS (public IP certificate, no domain) ----------
# Let's Encrypt issues short-lived (~6 day) certs for public IPs.
# HTTP-01 validation requires WAN:80 → this server:80 to be reachable.
# Public HTTPS requires WAN:443 → this server:4433.
PUBLIC_IP=REPLACE_WITH_PUBLIC_IP
CERTBOT_EMAIL=REPLACE_WITH_ADMIN_EMAIL
# 1 = Let's Encrypt staging (testing); 0 = production/trusted.
CERTBOT_STAGING=0

# ---------- Auth (GENERATE fresh values — never reuse dev/demo secrets) ----------
# 64+ random hex chars, e.g. from:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_64_HEX_CHARS
JWT_EXPIRES_IN=1d
COOKIE_NAME=token
# Cookies are marked Secure automatically on HTTPS requests and left
# non-Secure on plain-HTTP LAN requests. Set true only to force Secure.
COOKIE_SECURE=false

# ---------- MongoDB ----------
MONGO_ROOT_USER=dtadmin
# URL-ENCODE if it contains @ : / ? # [ ] — safest is letters+digits+_.-
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Live database files (Docker named volume `mongo-data`, NOT a host folder).
# HOST_MONGO_DIR is legacy and unused — leave it unset.
# NOTE: MONGO_URI is assembled in docker-compose.yml from the two vars above;
# it is NOT set here (single source of truth, no drift).

# ---------- File storage (host HDD paths, Windows style with forward slashes) ----------
# Uploads live here on the HOST filesystem: survive container loss AND `down -v`.
HOST_UPLOADS_DIR=D:/designtree-uploads
# mongodump archives land here (written by scripts/backup.ps1 via the container).
HOST_BACKUPS_DIR=E:/DesignTree/backup

# ---------- Seed superuser login (one-shot `npm run seed`, then rotate password in-app) ----------
SEED_NAME=Superuser
SEED_EMAIL=superuser@designtree.com
SEED_PASSWORD=REPLACE_WITH_ONE_TIME_PASSWORD

# ---------- DB admin (optional, `dbadmin` profile, loopback-only) ----------
# The gateway always returns 403 for /dbadmin; access is only via
# http://127.0.0.1:18081/dbadmin/ on the server itself (or an SSH tunnel).
# Start it explicitly with: docker compose --profile dbadmin up -d mongo-express
ME_CONFIG_BASICAUTH_USERNAME=founding-director
ME_CONFIG_BASICAUTH_PASSWORD=REPLACE_WITH_DBADMIN_PASSWORD
